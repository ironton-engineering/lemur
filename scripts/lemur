#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
INSTALL_ROOT="${LEMUR_INSTALL_ROOT:-$HOME/.local/share/llm-hub}"

usage() {
  cat <<'EOF'
Usage: lemur [command]

Commands:
  start           Start Lemur. This is the default command.
  doctor          Check Ubuntu, GPU, driver, files, ports, and permissions.
  update          Install the latest Lemur release.
  rollback        Activate the prior working release.
  install-vllm    Install the optional vLLM backend.
  support-report  Print a report with personal paths removed.
  uninstall       Remove Lemur. User data is kept by default.
  version         Show the installed version.
  help            Show this help.
EOF
}

command_name="${1:-start}"
case "$command_name" in
  start)
    exec "$ROOT/scripts/run.sh"
    ;;
  doctor)
    status=0
    python3 "$ROOT/scripts/system_probe.py" --install-root "$INSTALL_ROOT" || status=$?
    current="$(readlink -f "$INSTALL_ROOT/current" 2>/dev/null || true)"
    [[ -n "$current" && -d "$current" ]] || { printf 'ERROR: Active Lemur release is missing.\n'; status=1; }
    # shellcheck disable=SC1091
    source "$ROOT/release/versions.env"
    llama="$INSTALL_ROOT/backends/llama.cpp-$LLAMA_CPP_VERSION/bin/llama-server"
    if [[ ! -x "$llama" ]] || ! "$llama" --version; then
      printf 'ERROR: llama-server is missing or does not start.\n'
      status=1
    fi
    [[ -w "$INSTALL_ROOT" ]] || { printf 'ERROR: The install directory is not writable.\n'; status=1; }
    [[ -w "${XDG_CONFIG_HOME:-$HOME/.config}/lemur" ]] || { printf 'ERROR: The config directory is not writable.\n'; status=1; }
    python3 - <<'PY' || status=1
import socket
s = socket.socket()
try:
    s.bind(("127.0.0.1", 9000))
except OSError:
    print("NOTE: Port 9000 is in use. Lemur can already be running.")
finally:
    s.close()
PY
    exit "$status"
    ;;
  update)
    shift || true
    tmp_file="$(mktemp)"
    trap 'rm -f -- "$tmp_file"' EXIT
    curl --fail --location --proto '=https' --tlsv1.2 \
      https://github.com/ironton-engineering/lemur/releases/latest/download/install.sh \
      --output "$tmp_file"
    args=()
    if compgen -G "$INSTALL_ROOT/backends/vllm-*" >/dev/null; then
      args+=(--with-vllm)
    fi
    bash "$tmp_file" "${args[@]}" "$@"
    ;;
  rollback)
    previous="$(readlink -f "$INSTALL_ROOT/previous" 2>/dev/null || true)"
    current="$(readlink -f "$INSTALL_ROOT/current" 2>/dev/null || true)"
    [[ -n "$previous" && -d "$previous" ]] || { printf 'ERROR: No prior release is available.\n' >&2; exit 1; }
    ln -sfn "$current" "$INSTALL_ROOT/previous"
    ln -sfn "$previous" "$INSTALL_ROOT/current"
    printf 'Active release: %s\n' "$(basename "$previous")"
    ;;
  install-vllm)
    exec "$ROOT/scripts/install-vllm.sh"
    ;;
  support-report)
    report="$(python3 "$ROOT/scripts/system_probe.py" --json 2>/dev/null || true)"
    python3 - "$ROOT" "$report" <<'PY'
import json
import os
import sys
from pathlib import Path

root = Path(sys.argv[1])
try:
    system = json.loads(sys.argv[2])
except json.JSONDecodeError:
    system = {"ok": False, "errors": ["System probe failed"]}
home = str(Path.home())
versions = {}
for name, path in {
    "lemur": root / "VERSION",
    "llama_cpp": root / "release/versions.env",
}.items():
    try:
        versions[name] = path.read_text().strip()
    except OSError:
        versions[name] = "missing"
payload = {"system": system, "versions": versions}
text = json.dumps(payload, indent=2)
print(text.replace(home, "<HOME>"))
PY
    ;;
  uninstall)
    shift || true
    exec "$ROOT/scripts/uninstall.sh" "$@"
    ;;
  version|--version)
    printf 'Lemur %s\n' "$(tr -d '[:space:]' < "$ROOT/VERSION")"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    printf 'ERROR: Unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
